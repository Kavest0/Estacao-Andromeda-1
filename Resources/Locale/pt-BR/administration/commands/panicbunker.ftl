cmd-panicbunker-desc = Alterna o bunker de pânico, que ativa restrições mais rígidas sobre quem pode entrar no servidor.
cmd-panicbunker-help = Uso: panicbunker
panicbunker-command-enabled = Bunker de pânico ativado.
panicbunker-command-disabled = Bunker de pânico desativado.

cmd-panicbunker_disable_with_admins-desc = Alterna se o bunker de pânico será desativado automaticamente quando um administrador se conectar.
cmd-panicbunker_disable_with_admins-help = Uso: panicbunker_disable_with_admins
panicbunker-command-disable-with-admins-enabled = O bunker de pânico será desativado automaticamente com administradores online.
panicbunker-command-disable-with-admins-disabled = O bunker de pânico não será desativado automaticamente com administradores online.

cmd-panicbunker_enable_without_admins-desc = Alterna se o bunker de pânico será ativado automaticamente quando o último administrador se desconectar.
cmd-panicbunker_enable_without_admins-help = Uso: panicbunker_enable_without_admins
panicbunker-command-enable-without-admins-enabled = O bunker de pânico será ativado automaticamente sem administradores online.
panicbunker-command-enable-without-admins-disabled = O bunker de pânico não será ativado automaticamente sem administradores online.

cmd-panicbunker_count_deadminned_admins-desc = Alterna se administradores desativados serão contabilizados ao ativar ou desativar automaticamente o bunker de pânico.
cmd-panicbunker_count_deadminned_admins-help = Uso: panicbunker_count_deadminned_admins
panicbunker-command-count-deadminned-admins-enabled = O bunker de pânico irá contar administradores desativados ao ativar ou desativar automaticamente.
panicbunker-command-count-deadminned-admins-disabled = O bunker de pânico não irá contar administradores desativados ao ativar ou desativar automaticamente.

cmd-panicbunker_show_reason-desc = Alterna se os clientes verão o motivo pelo qual foram bloqueados pelo bunker de pânico.
cmd-panicbunker_show_reason-help = Uso: panicbunker_show_reason
panicbunker-command-show-reason-enabled = O bunker de pânico agora mostrará o motivo aos usuários bloqueados.
panicbunker-command-show-reason-disabled = O bunker de pânico não mostrará mais o motivo aos usuários bloqueados.

cmd-panicbunker_min_account_age-desc = Obtém ou define a idade mínima da conta (em minutos) para que ela possa se conectar com o bunker de pânico ativado.
cmd-panicbunker_min_account_age-help = Uso: panicbunker_min_account_age <minutos>
panicbunker-command-min-account-age-is = A idade mínima da conta para o bunker de pânico é de {$minutes} minutos.
panicbunker-command-min-account-age-set = Idade mínima da conta para o bunker de pânico definida para {$minutes} minutos.

cmd-panicbunker_min_overall_minutes-desc = Obtém ou define o tempo total mínimo de jogo (em minutos) que uma conta deve ter para se conectar com o bunker de pânico ativado.
cmd-panicbunker_min_overall_minutes-help = Uso: panicbunker_min_overall_minutes <minutos>
panicbunker-command-min-overall-minutes-is = O tempo total mínimo de jogo para o bunker de pânico é de {$minutes} minutos.
panicbunker-command-min-overall-minutes-set = Tempo total mínimo de jogo para o bunker de pânico definido para {$minutes} minutos.
